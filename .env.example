# Copy to .env and adjust.

# Host folder that holds the live database and backups. Relative paths are
# relative to this folder. Keep the quotes: the default contains spaces.
# The folder must already exist.
DATA_DIR="../Savings Server Data"

# Host port the web UI listens on.
PORT=8090

# Admin pages (account approvals etc.). Only reachable from this PC: http://localhost:8091
ADMIN_PORT=8091

# Timezone: decides what "today" is and when the daily backup runs (e.g. Europe/Berlin).
TZ=Europe/Athens

# Daily backup time (24h, in the timezone above) and how many days of backups to keep.
BACKUP_TIME=03:30
BACKUP_RETENTION_DAYS=30

# User/group the containers run as, so files in DATA_DIR belong to you.
# Find yours with: id -u ; id -g
PUID=1000
PGID=1000

# Start with Docker at boot: unless-stopped (default) or no. "savings autostart on|off" sets it.
RESTART=unless-stopped

# Container and image names (change them only to run a second copy side by side).
CONTAINER_NAME=savings
COMPOSE_PROJECT_NAME=savings
IMAGE=savings:latest
